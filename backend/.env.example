DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wedu
# Pool por processo da API; total no banco = workers * (DB_POOL_SIZE + DB_MAX_OVERFLOW)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
REDIS_URL=redis://localhost:6379/2
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Login facial (Persona): chave publica Ed25519 (base64url, 32 bytes) que confere o assertion
# de rosto conferido. Vazio desativa POST /auth/facial-login.
PERSONA_ASSERTION_PUBLIC_KEY=

BEVOX_URL=http://localhost:8001
BEVOX_PUBLIC_URL=
WMATRIX_URL=http://localhost:8000
WOMNI_URL=
WOMNI_API_TOKEN=
NOTIFICATION_DISPATCH_TIMEOUT_SECONDS=10
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_SECONDS=60
NOTIFICATION_WORKER_BATCH_SIZE=100
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Instituicao por subdominio (ex.: wedu.com.br -> escola.wedu.com.br). Vazio desativa.
TENANT_BASE_DOMAIN=
# Salario minimo de referencia (Banco Central, SGS 1619); vazio usa MINIMUM_WAGE_FALLBACK_CENTS.
MINIMUM_WAGE_API_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs.1619/dados
MINIMUM_WAGE_FALLBACK_CENTS=162100
